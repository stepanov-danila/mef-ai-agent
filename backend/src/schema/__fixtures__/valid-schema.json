{
  "id": "https://mef.example.com/schemas/mef-config.json",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "MEF Config",
  "type": "object",
  "properties": {
    "modelName": {
      "$ref": "#/definitions/modelName"
    },
    "modelType": {
      "$ref": "#/definitions/modelType"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" }
      },
      "required": ["kind"]
    }
  },
  "required": ["modelName", "modelType"],
  "definitions": {
    "modelName": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "modelType": {
      "type": "string",
      "enum": ["PythonModel", "JavaModel", "SparkApplication", "Triton"]
    }
  }
}
